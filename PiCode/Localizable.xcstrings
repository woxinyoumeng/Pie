    },
    "Pi is not running…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 未运行…"
          }
        }
      }
    },
    "Pi is reading the session history": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 正在读取会话历史"
          }
        }
      }
    },
    "Pi is running with `--no-approve`, so this project's resources are ignored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 正以 `--no-approve` 运行,因此此项目的资源被忽略。"
          }
        }
      }
    },
    "Pi offered a surface PiCode cannot render: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 提供了一个 PiCode 无法渲染的界面:%@"
          }
        }
      }
    },
    "Pi packages run with full access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 包以完整权限运行"
          }
        }
      }
    },
    "Pi reported an error": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 报告了一个错误"
          }
        }
      }
    },
    "Pi runs as you — the current macOS user — so it can read and write the files your account can, and run shell commands with your permissions. Trusting a project does not change any of that: it only decides whether Pi loads that project's own settings, extensions, skills, prompts, themes, and system prompts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 以你 —— 当前 macOS 用户 —— 的身份运行,因此能读写你账号可访问的文件,并以你的权限执行 shell 命令。信任项目不会改变这些:它只决定 Pi 是否加载该项目自带的设置、扩展、技能、提示词、主题和系统提示词。"
          }
        }
      }
    },
    "Pi sent an extension UI request PiCode does not render yet. The extension keeps running; this request was ignored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 发送了 PiCode 尚不支持的扩展界面请求。扩展仍在运行,该请求已被忽略。"
          }
        }
      }
    },
    "Pi stopped retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 已停止重试。"
          }
        }
      }
    },
    "Pi stores the name in the session file, so other Pi clients see it too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 会把名称存入会话文件,因此其他 Pi 客户端也能看到。"
          }
        }
      }
    },
    "Pi summarizes the conversation, keeping what you describe here. Your existing messages stay in the session file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 会压缩对话,保留你在此描述的内容。已有消息仍留在会话文件中。"
          }
        }
      }
    },
    "Pi touched this file %lld times this session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 本次会话改动了此文件 %lld 次"
          }
        }
      }
    },
    "Pi truncated this output. Full text saved at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 截断了此输出,完整文本已保存到 %@。"
          }
        }
      }
    },
    "Pi walks the whole session for this list, so long sessions take a while.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 会遍历整个会话以生成此列表,因此长会话需要一些时间。"
          }
        }
      }
    },
    "Pi was not found": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Pi"
          }
        }
      }
    },
    "Pi was not found, so packages cannot be installed or removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Pi,因此无法安装或移除包。"
          }
        }
      }
    },
