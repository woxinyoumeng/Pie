    "Pi has not reported any forkable messages yet. Send a message first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 还没有报告任何可派生的消息。请先发送一条消息。"
          }
        }
      }
    },
    "Pi has not reported usage yet.": {
      "localizations": {
        "zh-Hans": {
