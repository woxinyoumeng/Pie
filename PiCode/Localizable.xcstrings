{
  "sourceLanguage": "en",
  "strings": {
    " (AppleScript-based and binary formats are not attached.)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(AppleScript 与二进制格式不会被附加。)"
          }
        }
      }
    },
    "%@\nPiCode indexes these files read-only and never rewrites them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nPiCode 以只读方式索引这些文件,从不改写。"
          }
        }
      }
    },
    "%@ contains project resources Pi can load: settings, extensions, skills, prompts, themes, or system prompts. Pi will not load them unless you trust this project.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 包含 Pi 可加载的项目资源:设置、扩展、技能、提示词、主题或系统提示词。除非你信任此项目,否则 Pi 不会加载它们。"
          }
        }
      }
    },
    "%@ could not load its models: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法加载其模型:%@"
          }
        }
      }
    },
    "%@ could not start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法启动"
          }
        }
      }
    },
    "%@ did not return any compatible models.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未返回任何兼容的模型。"
          }
        }
      }
    },
    "%@ did not return any providers. Configure one in Settings → Providers, then reopen this menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未返回任何服务商。请在「设置 → 服务商」中配置后重新打开此菜单。"
          }
        }
      }
    },
    "%@ failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失败。"
          }
        }
      }
    },
    "%@ installation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 安装"
          }
        }
      }
    },
    "%@ is larger than %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 大于 %@。"
          }
        }
      }
    },
    "%@ is larger than %@. Use an @path reference instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 大于 %@。请改用 @path 引用。"
          }
        }
      }
    },
    "%@ is not an image or a text file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是图片或文本文件。"
          }
        }
      }
    },
    "%@ model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 模型"
          }
        }
      }
    },
    "%@ owns its provider configuration and model catalog. Start the chat, then choose one of the models it reports in the composer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 自行管理其服务商配置与模型目录。开始对话后,在输入区中选择它报告的模型。"
          }
        }
      }
    },
    "%@ stopped%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止%@"
          }
        }
      }
    },
