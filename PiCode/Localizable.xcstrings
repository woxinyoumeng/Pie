{
  "sourceLanguage": "en",
  "strings": {
    "A literal key is stored with this provider. `$ENV_VAR` or `!command` keeps the secret elsewhere.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务商保存的是明文密钥。若想让密钥留在别处,可改用 `$ENV_VAR` 或 `!command`。"
          }
        }
      }
    },
