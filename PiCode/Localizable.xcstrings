            "state": "translated",
            "value": "Pi 安装帮助"
          }
        }
      }
    },
    "Pi builds the session tree as messages are exchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 会在消息往来中构建会话树。"
          }
        }
      }
    },
    "Pi cannot read %lld credential entries.": {
      "localizations": {
