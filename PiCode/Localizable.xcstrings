    "Pi configuration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 配置"
          }
        }
      }
    },
    "Pi could not load its credential or model configuration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 无法加载其凭据或模型配置"
          }
